# Copy to .env (gitignored). Only needed for gated or private Hugging Face models.
HF_TOKEN=
# The document database. Default: sqlite:///data/documents.sqlite. A hosted Postgres works too
# (needs a driver: uv add psycopg). Quote it if the password contains # or spaces.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Force a device instead of auto-detecting: cuda, mps or cpu.
# DEVICE=cpu
# Without a C compiler (gcc), torch's Triton GPU kernels are switched off automatically.
# Install build-essential and set this to 0 to keep them.
# TORCH_DISABLE_NATIVE_JIT=0
